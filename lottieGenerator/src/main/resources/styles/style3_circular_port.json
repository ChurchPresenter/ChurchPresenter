{
    "formatVersion": 1,
    "id": "",
    "name": "Circular (Style 3 port)",
    "layout": {
        "slots": [
            {
                "id": "badge",
                "kind": "FIXED",
                "widthEm": 5.5,
                "visibleWhen": ["LOGO_ENABLED"]
            },
            {
                "id": "text",
                "kind": "TEXT",
                "gapBeforeEm": 0.75
            },
            {
                "id": "pad",
                "kind": "FIXED",
                "widthEm": 0.6666666666666666
            }
        ],
        "blockHeightEm": 5.5,
        "centerSingleLine": false
    },
    "elements": [
        {
            "type": "logo",
            "id": "logo",
            "name": "Logo",
            "visibleWhen": ["LOGO_ENABLED"],
            "sizeEm": 4.5,
            "placement": {
                "slot": "badge",
                "anchorIn": "CENTER",
                "line": "BLOCK_CENTER"
            },
            "tracks": [
                {
                    "property": "ROTATION",
                    "keyframes": [
                        { "pct": 0.0, "values": [90.0] },
                        { "pct": 40.0, "values": [0.0] },
                        { "pct": 100.0, "values": [0.0] }
                    ],
                    "alignOverrides": {
                        "right": [
                            { "pct": 0.0, "values": [-90.0] },
                            { "pct": 40.0, "values": [0.0] },
                            { "pct": 100.0, "values": [0.0] }
                        ]
                    }
                },
                {
                    "property": "SCALE",
                    "keyframes": [
                        { "pct": 0.0, "values": [0.0, 0.0] },
                        { "pct": 40.0, "values": [100.0, 100.0] },
                        { "pct": 100.0, "values": [100.0, 100.0] }
                    ]
                }
            ]
        },
        {
            "type": "text",
            "id": "name",
            "name": "Name",
            "field": "NAME",
            "visibleWhen": ["NAME_VISIBLE"],
            "placement": {
                "slot": "text",
                "anchorIn": "START",
                "line": "NAME_LINE"
            },
            "maskReveal": {
                "padPx": 20.0,
                "heightFactor": 1.5,
                "yOffsetFactor": -0.15
            },
            "tracks": [
                {
                    "property": "POSITION_OFFSET",
                    "offsetUnit": "EM",
                    "keyframes": [
                        { "pct": 0.0, "values": [0.0, 5.61] },
                        { "pct": 70.0, "values": [0.0, 5.61] },
                        { "pct": 100.0, "values": [0.0, 0.0] }
                    ]
                }
            ]
        },
        {
            "type": "text",
            "id": "info",
            "name": "Info",
            "field": "INFO",
            "visibleWhen": ["INFO_VISIBLE"],
            "placement": {
                "slot": "text",
                "anchorIn": "START",
                "line": "INFO_LINE"
            },
            "maskReveal": {
                "padPx": 20.0,
                "heightFactor": 1.5,
                "yOffsetFactor": -0.15
            },
            "tracks": [
                {
                    "property": "POSITION_OFFSET",
                    "offsetUnit": "EM",
                    "keyframes": [
                        { "pct": 0.0, "values": [0.0, -5.61] },
                        { "pct": 70.0, "values": [0.0, -5.61] },
                        { "pct": 100.0, "values": [0.0, 0.0] }
                    ]
                }
            ]
        },
        {
            "type": "rect",
            "id": "logoBg",
            "name": "Logo BG",
            "visibleWhen": ["LOGO_ENABLED"],
            "placement": {
                "slot": "badge",
                "anchorIn": "CENTER",
                "line": "BLOCK_CENTER"
            },
            "size": { "type": "em", "wEm": 5.5, "hEm": 5.5 },
            "paint": {
                "fill": { "role": "ACCENT" },
                "stroke": { "role": "BORDER", "width": { "type": "fromConfig" } }
            },
            "corner": { "type": "fromConfig", "factor": 1.0 },
            "growFrom": "CENTER",
            "tracks": [
                {
                    "property": "ROTATION",
                    "keyframes": [
                        { "pct": 0.0, "values": [90.0] },
                        { "pct": 40.0, "values": [0.0] },
                        { "pct": 100.0, "values": [0.0] }
                    ],
                    "alignOverrides": {
                        "right": [
                            { "pct": 0.0, "values": [-90.0] },
                            { "pct": 40.0, "values": [0.0] },
                            { "pct": 100.0, "values": [0.0] }
                        ]
                    }
                },
                {
                    "property": "SCALE",
                    "keyframes": [
                        { "pct": 0.0, "values": [0.0, 0.0] },
                        { "pct": 40.0, "values": [100.0, 100.0] },
                        { "pct": 100.0, "values": [100.0, 100.0] }
                    ]
                }
            ]
        },
        {
            "type": "rect",
            "id": "backgroundBar",
            "name": "Background Bar",
            "visibleWhen": ["BG_ENABLED"],
            "placement": {
                "slot": "block",
                "anchorIn": "END",
                "line": "BLOCK_CENTER"
            },
            "size": { "type": "textWrap", "field": "NAME", "padXEm": 0.9166666666666666, "padYEm": 1.9 },
            "paint": {
                "fill": { "role": "BG" },
                "stroke": { "role": "BORDER", "width": { "type": "fromConfig" } }
            },
            "corner": { "type": "fromConfig", "factor": 1.1 },
            "growFrom": "CENTER",
            "tracks": [
                {
                    "property": "POSITION_OFFSET",
                    "offsetUnit": "ELEMENT_WIDTH",
                    "keyframes": [
                        { "pct": 0.0, "values": [-1.0, 0.0] },
                        { "pct": 40.0, "values": [-1.0, 0.0] },
                        { "pct": 100.0, "values": [-0.5, 0.0] }
                    ]
                },
                {
                    "property": "RECT_SIZE",
                    "keyframes": [
                        { "pct": 0.0, "values": [0.0, 1.0] },
                        { "pct": 40.0, "values": [0.0, 1.0] },
                        { "pct": 100.0, "values": [1.0, 1.0] }
                    ]
                },
                {
                    "property": "STROKE_WIDTH",
                    "keyframes": [
                        { "pct": 0.0, "values": [0.0] },
                        { "pct": 40.0, "values": [0.0] },
                        { "pct": 100.0, "values": [1.0] }
                    ]
                }
            ]
        }
    ]
}
