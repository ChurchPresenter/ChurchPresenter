            "tracks": [
                {
                    "property": "TRIM",
                    "keyframes": [
                        { "pct": 0.0, "values": [0.0, 0.0] },
                        { "pct": 8.0, "values": [0.0, 0.0] },
                        { "pct": 55.0, "values": [0.0, 1.0] },
                        { "pct": 100.0, "values": [0.0, 1.0] }
