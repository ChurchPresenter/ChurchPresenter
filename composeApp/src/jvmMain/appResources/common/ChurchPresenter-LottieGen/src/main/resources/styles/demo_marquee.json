{
    "formatVersion": 1,
    "id": "",
    "name": "Marquee",
    "layout": {
        "slots": [
            {
                "id": "logo",
                "kind": "LOGO",
                "gapAfterEm": 0.8,
                "visibleWhen": ["LOGO_ENABLED"]
            },
            {
                "id": "text",
                "kind": "TEXT",
                "gapBeforeEm": 0.4
            }
        ],
        "blockHeightEm": 4.2,
        "centerSingleLine": false
    },
    "elements": [
        {
            "type": "ellipse",
            "id": "bulbs",
            "name": "Bulbs",
            "placement": {
                "slot": "block",
                "anchorIn": "START",
                "line": "BLOCK_CENTER",
                "offsetXEm": 0.4,
                "offsetYEm": -1.75
            },
            "size": { "type": "em", "wEm": 0.4, "hEm": 0.4 },
            "paint": { "fill": { "role": "ACCENT" } },
            "repeat": {
                "copies": 8,
                "offsetXEm": 1.2,
                "offsetYEm": 0.0,
                "rotationDeg": 0.0,
                "scalePct": 100.0,
                "fadeOut": false,
                "fitWidthTo": "TEXT_BLOCK"
            },
            "tracks": [
                {
                    "property": "SCALE",
                    "keyframes": [
                        { "pct": 0.0, "values": [0.0, 0.0] },
                        { "pct": 55.0, "values": [0.0, 0.0] },
                        { "pct": 80.0, "values": [100.0, 100.0] }
                    ]
                }
            ]
        },
        {
            "type": "logo",
            "id": "logo",
            "name": "Logo",
            "visibleWhen": ["LOGO_ENABLED"],
            "placement": {
                "slot": "logo",
                "anchorIn": "CENTER",
                "line": "BLOCK_CENTER",
                "offsetYEm": 0.3
            },
            "tracks": [
                {
                    "property": "OPACITY",
                    "keyframes": [
                        { "pct": 0.0, "values": [0.0] },
                        { "pct": 50.0, "values": [0.0] },
                        { "pct": 85.0, "values": [100.0] }
                    ]
                },
                {
                    "property": "SCALE",
                    "keyframes": [
                        { "pct": 0.0, "values": [60.0, 60.0] },
                        { "pct": 50.0, "values": [60.0, 60.0] },
                        { "pct": 85.0, "values": [100.0, 100.0] }
                    ]
                }
            ]
        },
        {
            "type": "text",
            "id": "name",
            "name": "Name",
            "field": "NAME",
            "visibleWhen": ["NAME_VISIBLE"],
            "placement": {
                "slot": "text",
                "anchorIn": "START",
                "line": "NAME_LINE",
                "offsetYEm": 0.5,
                "alignOverrides": {
                    "center": { "anchorIn": "CENTER" }
                }
            },
            "maskReveal": {
                "padPx": 20.0,
                "heightFactor": 1.5,
                "yOffsetFactor": -0.15
            },
            "tracks": [
                {
                    "property": "POSITION_OFFSET",
                    "offsetUnit": "ELEMENT_WIDTH",
                    "keyframes": [
                        { "pct": 0.0, "values": [-1.3, 0.0] },
                        { "pct": 30.0, "values": [-1.3, 0.0] },
                        { "pct": 70.0, "values": [0.0, 0.0] },
                        { "pct": 100.0, "values": [0.0, 0.0] }
                    ]
                }
            ]
        },
        {
            "type": "text",
            "id": "info",
            "name": "Info",
            "field": "INFO",
            "visibleWhen": ["INFO_VISIBLE"],
            "placement": {
                "slot": "text",
                "anchorIn": "START",
                "line": "INFO_LINE",
                "offsetYEm": 0.5,
                "alignOverrides": {
                    "center": { "anchorIn": "CENTER" }
                }
            },
            "animator": {
                "kind": "RANDOM_FADE",
                "startPct": 40.0,
                "endPct": 85.0
            }
        },
        {
            "type": "background",
            "id": "background",
            "name": "Background",
            "visibleWhen": ["BG_ENABLED"],
            "placement": {
                "slot": "block",
                "anchorIn": "CENTER",
                "line": "BLOCK_CENTER"
            },
            "size": { "type": "contentDerived", "padXEm": 1.2, "padYEm": 0.35 },
            "corner": { "type": "fromConfig", "factor": 1.0 },
            "borderFromConfig": false,
            "growFrom": "ALIGN_EDGE",
            "paint": {
                "fill": { "role": "BG" },
                "stroke": {
                    "role": "ACCENT",
                    "width": { "type": "em", "em": 0.12 },
                    "dashEm": 0.35
                }
            },
            "tracks": [
                {
                    "property": "RECT_SIZE",
                    "keyframes": [
                        { "pct": 0.0, "values": [0.0, 1.0] },
                        { "pct": 20.0, "values": [0.0, 1.0] },
                        { "pct": 75.0, "values": [1.0, 1.0] }
                    ]
                }
            ]
        }
    ]
}
