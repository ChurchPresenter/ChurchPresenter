{
    "formatVersion": 1,
    "id": "",
    "name": "Frame Draw",
    "layout": {
        "slots": [
            {
                "id": "logo",
                "kind": "LOGO",
                "gapAfterEm": 0.8,
                "visibleWhen": ["LOGO_ENABLED"]
            },
            {
                "id": "text",
                "kind": "TEXT",
                "gapBeforeEm": 0.4
            }
        ],
        "blockHeightEm": 3.5,
        "centerSingleLine": false
    },
    "elements": [
        {
            "type": "logo",
            "id": "logo",
            "name": "Logo",
            "visibleWhen": ["LOGO_ENABLED"],
            "placement": {
                "slot": "logo",
                "anchorIn": "CENTER",
                "line": "BLOCK_CENTER"
            },
            "tracks": [
                {
                    "property": "OPACITY",
                    "keyframes": [
                        { "pct": 0.0, "values": [0.0] },
                        { "pct": 50.0, "values": [0.0] },
                        { "pct": 85.0, "values": [100.0] }
                    ]
                }
            ]
        },
        {
            "type": "text",
            "id": "name",
            "name": "Name",
            "field": "NAME",
            "visibleWhen": ["NAME_VISIBLE"],
            "placement": {
                "slot": "text",
                "anchorIn": "START",
                "line": "NAME_LINE",
                "alignOverrides": {
                    "center": { "anchorIn": "CENTER" }
                }
            },
            "tracks": [
                {
                    "property": "OPACITY",
                    "keyframes": [
                        { "pct": 0.0, "values": [0.0] },
                        { "pct": 40.0, "values": [0.0] },
                        { "pct": 75.0, "values": [100.0] }
                    ]
                },
                {
                    "property": "POSITION_OFFSET",
                    "offsetUnit": "EM",
                    "keyframes": [
                        { "pct": 0.0, "values": [0.0, 0.8] },
                        { "pct": 40.0, "values": [0.0, 0.8] },
                        { "pct": 78.0, "values": [0.0, 0.0] },
                        { "pct": 100.0, "values": [0.0, 0.0] }
                    ]
                }
            ]
        },
        {
            "type": "text",
            "id": "info",
            "name": "Info",
            "field": "INFO",
            "visibleWhen": ["INFO_VISIBLE"],
            "placement": {
                "slot": "text",
                "anchorIn": "START",
                "line": "INFO_LINE",
                "alignOverrides": {
                    "center": { "anchorIn": "CENTER" }
                }
            },
            "tracks": [
                {
                    "property": "OPACITY",
                    "keyframes": [
                        { "pct": 0.0, "values": [0.0] },
                        { "pct": 52.0, "values": [0.0] },
                        { "pct": 87.0, "values": [100.0] }
                    ]
                },
                {
                    "property": "POSITION_OFFSET",
                    "offsetUnit": "EM",
                    "keyframes": [
                        { "pct": 0.0, "values": [0.0, 0.8] },
                        { "pct": 52.0, "values": [0.0, 0.8] },
                        { "pct": 90.0, "values": [0.0, 0.0] },
                        { "pct": 100.0, "values": [0.0, 0.0] }
                    ]
                }
            ]
        },
        {
            "type": "rect",
            "id": "frame",
            "name": "Frame",
            "placement": {
                "slot": "block",
                "anchorIn": "CENTER",
                "line": "BLOCK_CENTER"
            },
            "size": { "type": "contentDerived", "padXEm": 1.1, "padYEm": 0.7 },
            "paint": {
                "fill": null,
                "stroke": { "role": "ACCENT", "width": { "type": "em", "em": 0.12 } }
            },
            "corner": { "type": "fromConfig", "factor": 1.0 },
            "tracks": [
                {
                    "property": "TRIM",
                    "keyframes": [
                        { "pct": 0.0, "values": [0.0, 0.0] },
                        { "pct": 55.0, "values": [0.0, 1.0] },
                        { "pct": 100.0, "values": [0.0, 1.0] }
                    ]
                }
            ]
        },
        {
            "type": "background",
            "id": "background",
            "name": "Background",
            "visibleWhen": ["BG_ENABLED"],
            "placement": {
                "slot": "block",
                "anchorIn": "CENTER",
                "line": "BLOCK_CENTER"
            },
            "size": { "type": "contentDerived", "padXEm": 1.1, "padYEm": 0.7 },
            "corner": { "type": "fromConfig", "factor": 1.0 },
            "borderFromConfig": false,
            "growFrom": "CENTER",
            "tracks": [
                {
                    "property": "OPACITY",
                    "keyframes": [
                        { "pct": 0.0, "values": [0.0] },
                        { "pct": 25.0, "values": [0.0] },
                        { "pct": 60.0, "values": [100.0] }
                    ]
                }
            ]
        }
    ]
